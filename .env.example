# Retail Data Hub — Environment Template

# ── AI Security & Insights ─────────────────────────────
# Required for Anomaly Detection, Fraud Prevention & Chat
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── API Server Configuration ────────────────────────────
# Comma-separated list of allowed CORS origins (default: * without credentials)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Dashboard Connectivity ──────────────────────────────
# Point the dashboard to your live backend service on Render
NEXT_PUBLIC_API_URL=https://retail-data-hub-1n2u.onrender.com

# WebSocket URL for real-time transaction streaming
NEXT_PUBLIC_WS_URL=wss://retail-data-hub-1n2u.onrender.com/ws/live
